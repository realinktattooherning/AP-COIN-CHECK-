{
  "manifest_version": 3,
  "name": "DK Rug Scan - Stream",
  "version": "3.5",
  "description": "Stream screenshot to token address, market data and rug checks. Local OCR, read-only.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "DK Rug Scan - Stream 3.5",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.rugcheck.xyz/*",
    "https://api.geckoterminal.com/*",
    "https://frontend-api-v3.pump.fun/*",
    "https://solana-rpc.publicnode.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://solana-rpc.web.helium.io/*",
    "https://*.helius-rpc.com/*",
    "https://api.gopluslabs.io/*",
    "https://api.honeypot.is/*",
    "https://gateway.pinata.cloud/*",
    "https://ipfs.filebase.io/*",
    "https://4everland.io/*",
    "https://metadata.j7tracker.io/*",
    "https://gateway.irys.xyz/*",
    "https://meta.uxento.io/*",
    "https://www.agencypad.fun/*",
    "https://launch.mosaicfi.xyz/*",
    "https://arweave.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pumpfun",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "screen.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  }
}
